# Database: either a single URL (Railway: DATABASE_URL=${{MySQL.MYSQL_URL}}) ...
# DATABASE_URL=mysql://user:password@host:3306/donnasFlowerShop
# ... or individual values:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=donnasFlowerShop

PORT=5004
JWT_SECRET=change_this_development_secret
CLIENT_ORIGIN=http://localhost:5177
TZ=Asia/Manila

# Create tables on boot and seed an empty database with sample data (default: true)
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
# Keep generating realistic shop activity every hour (demo deployments only)
DEMO_MODE=false

# Passwords for the seeded owner / cashier accounts (default: "password")
# OWNER_PASSWORD=
# CASHIER_PASSWORD=
